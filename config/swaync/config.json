{
  "hide-on-action": true,
  "script-fail-notify": false,
  "scripts": {
    "focus-signal-by-name": {
      "exec": "sh -lc 'exec \"$HOME/.config/swaync/focus-chat-notification.sh\" signal'",
      "app-name": "Signal",
      "run-on": "receive"
    },
    "focus-signal-by-desktop-entry": {
      "exec": "sh -lc 'exec \"$HOME/.config/swaync/focus-chat-notification.sh\" signal'",
      "desktop-entry": "signal|signal-desktop",
      "run-on": "receive"
    },
    "focus-whatsapp-by-name": {
      "exec": "sh -lc 'exec \"$HOME/.config/swaync/focus-chat-notification.sh\" whatsapp'",
      "app-name": "WhatsApp|Whatsapp|WhatsApp Electron",
      "run-on": "receive"
    },
    "focus-whatsapp-by-desktop-entry": {
      "exec": "sh -lc 'exec \"$HOME/.config/swaync/focus-chat-notification.sh\" whatsapp'",
      "desktop-entry": "com.github.dagmoller.whatsapp-electron",
      "run-on": "receive"
    },
    "focus-telegram-by-name": {
      "exec": "sh -lc 'exec \"$HOME/.config/swaync/focus-chat-notification.sh\" telegram'",
      "app-name": "Telegram|Telegram Desktop",
      "run-on": "receive"
    },
    "focus-telegram-by-desktop-entry": {
      "exec": "sh -lc 'exec \"$HOME/.config/swaync/focus-chat-notification.sh\" telegram'",
      "desktop-entry": "org.telegram.desktop|telegramdesktop|telegram-desktop",
      "run-on": "receive"
    }
  }
}
